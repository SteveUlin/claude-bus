/build/
/build-*/
/result
/.direnv/
/compile_commands.json
/.cache/
/.claude/scheduled_tasks.lock

# Canonical Claude Code project config lives at settings/claude-settings.json
# (tracked, public). Each jj workspace's .claude/settings.json is a symlink
# to it, created by bin/agent-launch — gitignored so jj never materializes
# divergent per-workspace copies. Edit the canonical file, not this path.
/.claude/settings.json

# compiled binaries; CMake puts them next to any remaining shell scripts
/bin/bus
/bin/mailbox
/bin/watcher

# claude-code local notes (per-clone, not for the public repo)
/CLAUDE.local.md

# ad-hoc debugging artifacts — per CLAUDE.local.md, scratch lives outside the repo
/scratch/

# per-agent jj workspaces (auto-created by bin/agent-launch). One working
# copy per agent under .workspaces/<agent>; the shared .jj/repo collects
# commits. See docs/jj-workspace-workaround.md.
/.workspaces/

# editor cruft
*.swp
*.swo
*~
.DS_Store
.idea/
.vscode/

# build cruft (defense in depth — CMake should keep these in build/)
*.o
*.a
*.so
a.out
core
core.*

# stray root-level scratch (one-off experiments belong in /scratch or outside
# the repo, per CLAUDE.local.md). Anchored to root so legit fixtures elsewhere
# aren't caught. These were committed by accident (a getline experiment).
/test.txt
/test_getline.cpp

# env overrides + secrets
.env
.env.*
.envrc.local

# stray logs
*.log

# review workflow (workflows/review.js) hardened-synthesis checkpoint, written
# to cwd by a Write-agent each run — a regenerable artifact, never committed.
/review-synthesis-checkpoint.json

# Per-workspace symlink to the canonical hooks dir (settings/hooks-shared),
# created by bin/agent-launch. Gitignored so jj never sees the symlink and
# every workspace resolves $CLAUDE_PROJECT_DIR/settings/hooks/ to the shared
# canonical. Edit the scripts in settings/hooks-shared/, never settings/hooks.
/settings/hooks
