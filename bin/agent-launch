#!/usr/bin/env bash
# Exec claude with stable identity for agent NAME:
#   - claude --name NAME       (customTitle / prompt-box label / terminal
#     title / /resume picker)
#   - Each agent runs in its own jj workspace at $BUS_ROOT/.workspaces/NAME.
#     The workspace's cwd determines claude's session storage dir
#     (~/.claude/projects/<encoded-cwd>/), so each agent's sessions are
#     naturally namespaced and don't collide.
#   - Resume strategy (identity = --name, no session UUIDs):
#       1. One-time migration: if the workspace project dir has no
#          session for NAME yet, move any legacy session JSONLs whose
#          customTitle matches NAME from the BUS_ROOT-rooted project dir
#          (used before per-agent workspaces existed) into the workspace
#          project dir. Idempotent.
#       2. If the workspace project dir contains any JSONL with
#          customTitle == NAME, pass --continue. claude resumes the
#          most recent in cwd (this agent's, since the workspace is
#          per-agent).
#       3. Otherwise launch fresh (no --continue, no --session-id).
#   - assigns a stable color from the 8 claude /color choices on first
#     run (stored at NAME.color); on resumed sessions claude already
#     remembers the color session-side. For fresh sessions we send
#     /color after the TUI is ready.
# Sets env for the bus and hooks: CLAUDE_BUS_AGENT_ID=NAME plus the
# pass-through CLAUDE_BUS_AGENT_{ROLE,KIND,WORKSPACE,PROJECT,SESSION}
# that the agent-register hook picks up. ROLE comes from --role; the
# others are inherited from the caller's env if set.
#
# With --role NAME, $BUS_ROOT/roles/NAME.md is stripped of YAML
# frontmatter and passed to claude as --append-system-prompt-file.
#
# Used by bin/spawn-agent (live spawn) and by layouts/fleet.kdl (boot-
# time spawn). Same identity rules apply either way.
#
# Usage: agent-launch [--role ROLE] NAME
set -euo pipefail

# Resolve repo root from this script's own location. Allows the bus to
# live anywhere; fleet layouts and spawn helpers no longer need to hard-
# code the path.
BUS_ROOT=${CLAUDE_BUS_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}

role=""
while [ $# -gt 0 ]; do
    case "$1" in
        --role)
            [ $# -lt 2 ] && { echo "agent-launch: --role requires an argument" >&2; exit 2; }
            role=$2
            shift 2
            ;;
        --role=*)
            role=${1#--role=}
            shift
            ;;
        --)
            shift
            break
            ;;
        --*)
            echo "agent-launch: unknown flag: $1" >&2
            exit 2
            ;;
        *)
            break
            ;;
    esac
done

if [ "$#" -ne 1 ]; then
    echo "usage: agent-launch [--role ROLE] NAME" >&2
    exit 2
fi

name=$1
cache_dir="$HOME/.cache/claude-bus/agents"
color_file="$cache_dir/$name.color"
mkdir -p "$cache_dir"

# Per-agent jj workspace. Each agent operates on its own working copy
# under $BUS_ROOT/.workspaces/$name, all backed by the shared .jj/repo
# (commits, branches, op log). Removes the "scoop-bundle" pattern where
# one agent's `jj describe` swept up another agent's uncommitted edits.
# See docs/jj-workspace-workaround.md for why we're using pure-jj
# workspaces (jj-vcs/jj#8052's colocated-workspaces feature isn't
# released yet; native `git` commands only work in the main $BUS_ROOT
# workspace).
#
# Set up the workspace BEFORE session detection so claude's cwd —
# which determines its project storage dir — is fixed before we look
# for prior sessions.
workspace_dir="$BUS_ROOT/.workspaces/$name"
if [ ! -d "$workspace_dir" ]; then
    mkdir -p "$BUS_ROOT/.workspaces"
    if ! (cd "$BUS_ROOT" && jj workspace add ".workspaces/$name" 2>&1); then
        echo "agent-launch: jj workspace add failed; launching in \$BUS_ROOT" >&2
    fi
fi
[ -d "$workspace_dir" ] || workspace_dir="$BUS_ROOT"
cd "$workspace_dir"

# --- Deterministic config propagation (1b) -------------------------------
# Materialize this workspace's Claude Code config from LANDED main on every
# launch, into gitignored paths. This REPLACES the old symlink-to-default-
# checkout, which went stale whenever the default workspace lagged main
# (the recurring "config push doesn't reach agents" bug).
#
# Source of truth = jj's LOCAL main bookmark, read with --ignore-working-
# copy: that skips the working-copy snapshot, so it works even though this
# (or any) workspace is "stale" — workspaces go stale constantly under
# concurrent ops, and a plain `jj`/symlink-to-a-checkout inherits that
# staleness. Reading main directly does not. Config therefore == landed
# main by construction; it propagates on land + relaunch, with zero
# dependence on reconciling the default tree.
#
# Resolve main's commit once (staleness-immune), then:
#  - claude-settings.json: a single `jj file show` into .claude/.
#  - settings/hooks-shared/*: `git archive` the subtree by that commit id
#    (one bulk export preserving examples/; reads the git object by sha, so
#    it's independent of whether git refs track jj bookmarks). chmod +x
#    since archive content is extracted mode-less here.
# Both targets are gitignored (/.claude/settings.json, /settings/hooks), so
# jj never sees these materialized copies. Touches only this workspace.
main_rev=$(jj --ignore-working-copy log --no-graph -r main -T 'commit_id' 2>/dev/null)
if [ -n "$main_rev" ]; then
    mkdir -p "$workspace_dir/.claude"
    if ! jj --ignore-working-copy file show -r "$main_rev" settings/claude-settings.json \
            > "$workspace_dir/.claude/settings.json" 2>/dev/null; then
        echo "agent-launch: WARN failed to materialize claude-settings.json from main" >&2
    fi
    rm -rf "$workspace_dir/settings/hooks"
    mkdir -p "$workspace_dir/settings/hooks"
    if git --git-dir="$BUS_ROOT/.git" archive "$main_rev" settings/hooks-shared 2>/dev/null \
            | tar -x --strip-components=2 -C "$workspace_dir/settings/hooks" 2>/dev/null; then
        chmod +x "$workspace_dir/settings/hooks"/*.sh 2>/dev/null
    else
        echo "agent-launch: WARN failed to materialize settings/hooks from main" >&2
    fi
else
    echo "agent-launch: WARN could not resolve main; config not refreshed" >&2
fi
# -------------------------------------------------------------------------

# --- Deterministic CODE propagation: auto-rebuild on drift (D4) ----------
# 1b (above) keeps CONFIG fresh per launch. CODE — this binary, this
# launcher, fleet.kdl — is a SINGLE shared artifact built from / run out of
# the default-tree checkout, which only advances when rebuilt. We detect
# drift by comparing the installed binary's build-commit stamp (`bus
# version`, full 40-hex) to landed main (main_rev, already resolved above —
# so the fast path adds only one `bus version` call + a string compare, no
# build). On drift, rebuild ONCE, flock-guarded, so N agents booting at once
# don't spawn N cmakes (first wins, the rest skip). The fresh binary lands on
# disk but the running broker + fleet ADOPT it only on restart/relaunch
# (printed below, never taken here — sulin's keyboard + the broker lifetime
# contract).
#
# SAFETY (unattended, so this matters more than for a manual step): the
# reconcile default-tree -> main step ABORTS if that tree is dirty — never
# `jj workspace update-stale` over uncommitted work (the data-loss trap). On
# dirty: warn loudly, skip the rebuild, boot against the stale binary. Never
# block boot, never clobber WIP.
if [ -n "$main_rev" ]; then
    built_commit=""
    [ -x "$BUS_ROOT/bin/bus" ] && built_commit=$("$BUS_ROOT/bin/bus" version \
        2>/dev/null | grep -oE '[0-9a-f]{40}' | head -1)
    if [ "$built_commit" != "$main_rev" ]; then
        disp=${built_commit:0:12}; [ -n "$disp" ] || disp="none"
        echo "agent-launch: code drift — bin/bus @ $disp, main @ ${main_rev:0:12}; rebuilding (flock-guarded)..." >&2
        rebuild_lock="$HOME/.cache/claude-bus/build.lock"
        (
            if flock -n 9; then
                # Re-check under the lock: a peer boot may have just rebuilt.
                cur=$("$BUS_ROOT/bin/bus" version 2>/dev/null \
                    | grep -oE '[0-9a-f]{40}' | head -1)
                [ "$cur" = "$main_rev" ] && exit 0
                # git-clean gate (reads the filesystem, so it works even when
                # jj reports the workspace stale). Never reconcile over WIP.
                if [ -n "$(git -C "$BUS_ROOT" status --porcelain 2>/dev/null)" ]; then
                    echo "agent-launch: WARN default tree dirty — skipping rebuild; booting STALE binary. Commit/land the WIP and relaunch to refresh." >&2
                    exit 0
                fi
                old_hash=none
                [ -x "$BUS_ROOT/bin/bus" ] && old_hash=$(sha256sum "$BUS_ROOT/bin/bus" | cut -d' ' -f1)
                # Reconcile only if the source itself lags (minimise touching
                # the default @). jj new main -> empty child of main; clean per
                # the gate, so no data loss.
                head=$(git -C "$BUS_ROOT" rev-parse HEAD 2>/dev/null)
                if [ "$head" != "$main_rev" ]; then
                    if ! ( cd "$BUS_ROOT" && jj new main ) >/dev/null 2>&1; then
                        echo "agent-launch: WARN reconcile to main failed — skipping rebuild (stale binary)" >&2
                        exit 0
                    fi
                fi
                # Re-configure (refreshes the build-commit stamp) then build.
                if ( cd "$BUS_ROOT" && nix develop --command bash -c \
                        'cmake -S . -B build >/dev/null && cmake --build build' ) \
                        >/dev/null 2>&1; then
                    new_commit=$("$BUS_ROOT/bin/bus" version 2>/dev/null \
                        | grep -oE '[0-9a-f]{40}' | head -1)
                    new_hash=$(sha256sum "$BUS_ROOT/bin/bus" | cut -d' ' -f1)
                    if [ "$old_hash" = "$new_hash" ]; then
                        echo "agent-launch: bin/bus reconfigured to ${new_commit:0:12} (no binary delta)" >&2
                    else
                        echo "agent-launch: *** bin/bus REBUILT ${old_hash:0:12} -> ${new_hash:0:12} (now @ ${new_commit:0:12}). RESTART the broker + RELAUNCH the fleet to ADOPT it (sulin's keyboard; broker lifetime contract — direct zellij child, never nohup/setsid). ***" >&2
                    fi
                else
                    echo "agent-launch: WARN rebuild FAILED — booting against the stale binary" >&2
                fi
            else
                echo "agent-launch: another boot holds the rebuild lock — proceeding; this pane picks up the fresh binary on its next 'bus' call." >&2
            fi
        ) 9>"$rebuild_lock"
    fi
fi
# -------------------------------------------------------------------------

# claude-code encodes the project's absolute path into the session
# storage dir by replacing '/', '.', and '_' all with '-'. The encoded
# path itself begins with '-' (from the leading '/' of cwd); the literal
# slash sits between "projects" and the encoded path. Probed
# empirically: `/tmp/foo_bar/.baz` becomes `-tmp-foo-bar--baz`.
encode_dir() { printf '%s' "$1" | sed 's|[/._]|-|g'; }
project_dir="$HOME/.claude/projects/$(encode_dir "$workspace_dir")"
legacy_project_dir="$HOME/.claude/projects/$(encode_dir "$BUS_ROOT")"
mkdir -p "$project_dir"

# Returns 0 if $1 contains any JSONL whose first line declares
# customTitle == name.
has_session() {
    local f
    for f in "$1"/*.jsonl; do
        [ -f "$f" ] || continue
        if head -c 256 "$f" | grep -q "\"customTitle\":\"$name\""; then
            return 0
        fi
    done
    return 1
}

# One-time migration: pull any legacy sessions whose customTitle matches
# NAME from the BUS_ROOT-rooted project dir (the old shared location,
# used before workspaces) into the workspace project dir. Idempotent —
# only fires when the workspace has no session for NAME yet, so once a
# fresh session is established here, prior history won't be moved on
# top of it.
if [ "$project_dir" != "$legacy_project_dir" ] \
        && [ -d "$legacy_project_dir" ] \
        && ! has_session "$project_dir"; then
    for f in "$legacy_project_dir"/*.jsonl; do
        [ -f "$f" ] || continue
        if head -c 256 "$f" | grep -q "\"customTitle\":\"$name\""; then
            mv "$f" "$project_dir/"
        fi
    done
fi

# Resume by --continue when a prior session exists; otherwise launch
# fresh. claude's --continue picks the most recent JSONL in cwd, which
# (per-workspace) is this agent's last session.
if has_session "$project_dir"; then
    claude_flag=(--continue)
    fresh_session=0
else
    claude_flag=()
    fresh_session=1
fi

# Assign a deterministic color from claude's 8-color palette if we don't
# have one yet. cksum gives a stable name -> index.
if [ ! -f "$color_file" ]; then
    colors=(red blue green yellow purple orange pink cyan)
    idx=$(( $(printf '%s' "$name" | cksum | cut -d' ' -f1) % ${#colors[@]} ))
    printf '%s\n' "${colors[$idx]}" > "$color_file"
fi
color=$(cat "$color_file")

# Fresh sessions: fork a subshell that waits for claude's TUI to be up
# and then sends /color via the bus. The fork survives the exec below;
# one-shot per spawn, no daemon needed.
if [ "$fresh_session" = 1 ]; then
    (
        for _ in $(seq 1 30); do
            sleep 1
            mode=$("$BUS_ROOT/bin/bus" pane-state "$name" 2>/dev/null \
                | awk '/^mode:/ {print $2}')
            if [ "$mode" = "INSERT" ]; then
                "$BUS_ROOT/bin/bus" send "$name" "/color $color" \
                    >/dev/null 2>&1 || true
                break
            fi
        done
    ) &
fi

claude_role_flag=()
if [ -n "$role" ]; then
    role_file="$BUS_ROOT/roles/$role.md"
    if [ ! -f "$role_file" ]; then
        echo "agent-launch: role file not found: $role_file" >&2
        exit 1
    fi
    roles_cache="$HOME/.cache/claude-bus/roles"
    mkdir -p "$roles_cache"
    stripped="$roles_cache/${role}.stripped.md"
    awk 'BEGIN { in_fm = 0; done = 0 }
         NR == 1 && /^---$/ { in_fm = 1; next }
         in_fm && /^---$/ { in_fm = 0; done = 1; next }
         in_fm && !done { next }
         { print }' "$role_file" > "$stripped"
    claude_role_flag=(--append-system-prompt-file "$stripped")
fi

# Per-agent reasoning effort. comms is sulin's interface (converse / relay /
# surface) — keep it snappy at LOW. auri is the fleet PM/hub — give it the
# most headroom at XHIGH. Every other agent (coders) stays on claude's
# DEFAULT: the flag is omitted (not hardcoded), so they're untouched.
# Levels: low|medium|high|xhigh|max.
claude_effort_flag=()
case "$name" in
    comms) claude_effort_flag=(--effort low) ;;
    auri)  claude_effort_flag=(--effort xhigh) ;;
esac

export CLAUDE_BUS_AGENT_ID="$name"
export CLAUDE_BUS_AGENT_ROLE="$role"
export CLAUDE_BUS_AGENT_KIND="${CLAUDE_BUS_AGENT_KIND:-}"
export CLAUDE_BUS_AGENT_WORKSPACE="${CLAUDE_BUS_AGENT_WORKSPACE:-$workspace_dir}"
export CLAUDE_BUS_AGENT_PROJECT="${CLAUDE_BUS_AGENT_PROJECT:-}"
export CLAUDE_BUS_AGENT_SESSION="${CLAUDE_BUS_AGENT_SESSION:-}"

# After cd'ing into the workspace, `bin/bus` (relative) no longer
# resolves — the binary lives in the main $BUS_ROOT/bin and is
# gitignored, so agent workspaces don't carry it. Export CLAUDE_BUS_ROOT
# + put $BUS_ROOT/bin on PATH so `bus ...` works as a bare command and
# hooks can locate the binary absolutely.
export CLAUDE_BUS_ROOT="$BUS_ROOT"
case ":$PATH:" in
    *:"$BUS_ROOT/bin":*) ;;
    *) export PATH="$BUS_ROOT/bin:$PATH" ;;
esac

exec claude --name "$name" "${claude_flag[@]}" "${claude_role_flag[@]}" "${claude_effort_flag[@]}" --dangerously-skip-permissions
