#!/usr/bin/env bash
# Exec claude with stable identity for agent NAME:
#   - claude --name NAME       (prompt-box label / terminal title / /resume picker)
#   - Resume strategy, in order of preference:
#       1. ~/.cache/claude-bus/agents/NAME.session caches the UUID; resume
#          that directly.
#       2. If no cache, scan ~/.claude/projects/<cwd>/*.jsonl by mtime and
#          read line 1; the most recent one whose `customTitle` equals
#          NAME is this agent's last session. Write the UUID to the cache
#          so future spawns skip the scan.
#       3. Otherwise mint a new UUID, write the cache, start fresh.
#     The scan path lets a crashed/killed agent rehydrate by name without
#     the human passing a UUID — `spawn-agent NAME` Just Works.
#   - assigns a stable color from the 8 claude /color choices on first run
#     (stored at NAME.color); on resumed sessions claude already remembers
#     the color session-side. For fresh sessions we drop a NAME.pending
#     marker that a colorizer (or sibling subshell) picks up.
# Sets env for the bus and hooks: CLAUDE_BUS_AGENT_ID=NAME plus the
# pass-through CLAUDE_BUS_AGENT_{ROLE,KIND,WORKSPACE,PROJECT,SESSION}
# that the agent-register hook picks up. ROLE is set from --role; the
# others are inherited from the caller's env if set.
#
# With --role NAME, $BUS_ROOT/roles/NAME.md is stripped of YAML
# frontmatter and passed to claude as --append-system-prompt-file.
#
# Used by bin/spawn-agent (live spawn) and by layouts/fleet.kdl (boot-time
# spawn). Same identity rules apply either way.
#
# Usage: agent-launch [--role ROLE] NAME
set -euo pipefail

# Resolve repo root from this script's own location. Allows the bus to
# live anywhere; fleet layouts and spawn helpers no longer need to hard-
# code the path.
BUS_ROOT=${CLAUDE_BUS_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}

role=""
while [ $# -gt 0 ]; do
    case "$1" in
        --role)
            [ $# -lt 2 ] && { echo "agent-launch: --role requires an argument" >&2; exit 2; }
            role=$2
            shift 2
            ;;
        --role=*)
            role=${1#--role=}
            shift
            ;;
        --)
            shift
            break
            ;;
        --*)
            echo "agent-launch: unknown flag: $1" >&2
            exit 2
            ;;
        *)
            break
            ;;
    esac
done

if [ "$#" -ne 1 ]; then
    echo "usage: agent-launch [--role ROLE] NAME" >&2
    exit 2
fi

name=$1
sessions_dir="$HOME/.cache/claude-bus/agents"
session_file="$sessions_dir/$name.session"
color_file="$sessions_dir/$name.color"
# claude-code encodes the project's absolute path into the session
# storage dir by replacing '/' with '-' (leading '-' included), and
# stores it under ~/.claude/projects/<encoded>/. Note the slash between
# "projects" and the encoded path — the encoded path itself begins with
# '-' (from the leading '/' of BUS_ROOT).
project_dir="$HOME/.claude/projects/$(echo "$BUS_ROOT" | sed 's|/|-|g')"

mkdir -p "$sessions_dir"

# Locate the most-recent JSONL whose first line carries this agent's name
# in its customTitle. Returns the bare UUID, or empty on miss.
discover_session_id() {
    local f
    for f in $(ls -t "$project_dir"/*.jsonl 2>/dev/null); do
        if head -c 256 "$f" | grep -q "\"customTitle\":\"$name\""; then
            basename "$f" .jsonl
            return 0
        fi
    done
    return 1
}

fresh_session=0
session_id=""
if [ -f "$session_file" ]; then
    session_id=$(cat "$session_file")
    if [ ! -f "$project_dir/$session_id.jsonl" ]; then
        # Cache pointed at a session claude no longer has; treat as fresh
        # but reuse the same UUID so the identity is stable.
        fresh_session=1
    fi
else
    # No cache — try to rehydrate by name before minting a new UUID.
    if discovered=$(discover_session_id); then
        session_id=$discovered
        echo "$session_id" > "$session_file"
    else
        session_id=$(uuidgen)
        echo "$session_id" > "$session_file"
        fresh_session=1
    fi
fi

if [ "$fresh_session" = 1 ]; then
    claude_flag=(--session-id "$session_id")
else
    claude_flag=(--resume "$session_id")
fi

# Assign a deterministic color from claude's 8-color palette if we don't have
# one yet. cksum gives a stable name -> index.
if [ ! -f "$color_file" ]; then
    colors=(red blue green yellow purple orange pink cyan)
    idx=$(( $(printf '%s' "$name" | cksum | cut -d' ' -f1) % ${#colors[@]} ))
    printf '%s\n' "${colors[$idx]}" > "$color_file"
fi
color=$(cat "$color_file")

# Fresh sessions: fork a subshell that waits for claude's TUI to be up and
# then sends /color via the bus. The fork survives the exec below; we don't
# need a long-lived daemon since this is one shot per spawn.
if [ "$fresh_session" = 1 ]; then
    (
        for _ in $(seq 1 30); do
            sleep 1
            mode=$("$BUS_ROOT/bin/bus" pane-state "$name" 2>/dev/null \
                | awk '/^mode:/ {print $2}')
            if [ "$mode" = "INSERT" ]; then
                "$BUS_ROOT/bin/bus" send "$name" "/color $color" \
                    >/dev/null 2>&1 || true
                break
            fi
        done
    ) &
fi

claude_role_flag=()
if [ -n "$role" ]; then
    role_file="$BUS_ROOT/roles/$role.md"
    if [ ! -f "$role_file" ]; then
        echo "agent-launch: role file not found: $role_file" >&2
        exit 1
    fi
    roles_cache="$HOME/.cache/claude-bus/roles"
    mkdir -p "$roles_cache"
    stripped="$roles_cache/${role}.stripped.md"
    awk 'BEGIN { in_fm = 0; done = 0 }
         NR == 1 && /^---$/ { in_fm = 1; next }
         in_fm && /^---$/ { in_fm = 0; done = 1; next }
         in_fm && !done { next }
         { print }' "$role_file" > "$stripped"
    claude_role_flag=(--append-system-prompt-file "$stripped")
fi

export CLAUDE_BUS_AGENT_ID="$name"
export CLAUDE_BUS_AGENT_ROLE="$role"
export CLAUDE_BUS_AGENT_KIND="${CLAUDE_BUS_AGENT_KIND:-}"
export CLAUDE_BUS_AGENT_WORKSPACE="${CLAUDE_BUS_AGENT_WORKSPACE:-}"
export CLAUDE_BUS_AGENT_PROJECT="${CLAUDE_BUS_AGENT_PROJECT:-}"
export CLAUDE_BUS_AGENT_SESSION="${CLAUDE_BUS_AGENT_SESSION:-}"

# Per-agent jj workspace. Each agent operates on its own working copy
# under $BUS_ROOT/.workspaces/$name, all backed by the shared
# .jj/repo (commits, branches, op log). Removes the "scoop-bundle"
# pattern where one agent's `jj describe` swept up another agent's
# uncommitted edits. See docs/jj-workspace-workaround.md for the
# constraint analysis and why we're using pure-jj workspaces
# (jj-vcs/jj#8052's colocated-workspaces feature isn't released yet;
# native `git` commands only work in the main $BUS_ROOT workspace).
#
# Auto-create on first launch per sulin's call. Idempotent — repeat
# launches just cd into the existing workspace. If `jj workspace
# add` fails for any reason (jj missing, repo state weird), log and
# fall through to launching in $BUS_ROOT itself; that degrades to
# pre-isolation behaviour rather than blocking the agent.
workspace_dir="$BUS_ROOT/.workspaces/$name"
if [ ! -d "$workspace_dir" ]; then
    mkdir -p "$BUS_ROOT/.workspaces"
    if (cd "$BUS_ROOT" && jj workspace add ".workspaces/$name" 2>&1); then
        :
    else
        echo "agent-launch: jj workspace add failed; launching in \$BUS_ROOT" >&2
    fi
fi
if [ -d "$workspace_dir" ]; then
    cd "$workspace_dir"
    export CLAUDE_BUS_AGENT_WORKSPACE="${CLAUDE_BUS_AGENT_WORKSPACE:-$workspace_dir}"
fi

# After cd'ing into the workspace, `bin/bus` (relative) no longer
# resolves — the binary lives in the main $BUS_ROOT/bin and is
# gitignored, so agent workspaces don't carry it. Export CLAUDE_BUS_ROOT
# + put $BUS_ROOT/bin on PATH so `bus ...` works as a bare command and
# hooks can locate the binary absolutely.
export CLAUDE_BUS_ROOT="$BUS_ROOT"
case ":$PATH:" in
    *:"$BUS_ROOT/bin":*) ;;
    *) export PATH="$BUS_ROOT/bin:$PATH" ;;
esac

exec claude --name "$name" "${claude_flag[@]}" "${claude_role_flag[@]}" --dangerously-skip-permissions
