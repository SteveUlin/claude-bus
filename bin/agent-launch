#!/usr/bin/env bash
# Exec claude with stable identity for agent NAME:
#   - claude --name NAME       (customTitle / prompt-box label / terminal
#     title / /resume picker)
#   - Each agent runs in its own jj workspace at $BUS_ROOT/.workspaces/NAME.
#     The workspace's cwd determines claude's session storage dir
#     (~/.claude/projects/<encoded-cwd>/), so each agent's sessions are
#     naturally namespaced and don't collide.
#   - Resume strategy (identity = --name, no session UUIDs):
#       1. One-time migration: if the workspace project dir has no
#          session for NAME yet, move any legacy session JSONLs whose
#          customTitle matches NAME from the BUS_ROOT-rooted project dir
#          (used before per-agent workspaces existed) into the workspace
#          project dir. Idempotent.
#       2. If the workspace project dir contains any JSONL with
#          customTitle == NAME, pass --continue. claude resumes the
#          most recent in cwd (this agent's, since the workspace is
#          per-agent).
#       3. Otherwise launch fresh (no --continue, no --session-id).
#   - assigns a stable color from the 8 claude /color choices on first
#     run (stored at NAME.color); on resumed sessions claude already
#     remembers the color session-side. For fresh sessions we send
#     /color after the TUI is ready.
# Sets env for the bus and hooks: CLAUDE_BUS_AGENT_ID=NAME plus the
# pass-through CLAUDE_BUS_AGENT_{ROLE,KIND,WORKSPACE,PROJECT,SESSION}
# that the agent-register hook picks up. ROLE comes from --role; the
# others are inherited from the caller's env if set.
#
# With --role NAME, roles/NAME.md is read from LANDED main (same deterministic
# SHA-read as the config materialization), stripped of YAML frontmatter, and
# passed to claude as --append-system-prompt-file. Unlanded roles fall back to
# the working copy with a warning. Land a role to propagate it fleet-wide.
#
# Used by bin/spawn-agent (live spawn) and by layouts/fleet.kdl (boot-
# time spawn). Same identity rules apply either way.
#
# Usage: agent-launch [--role ROLE] NAME
set -euo pipefail

# Resolve repo root from this script's own location. Allows the bus to
# live anywhere; fleet layouts and spawn helpers no longer need to hard-
# code the path.
BUS_ROOT=${CLAUDE_BUS_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}

role=""
# PROJECT_ROOT is the repo the agent WORKS in (gets a jj workspace + cwd).
# Distinct from BUS_ROOT (claude-bus — the bus binary, hooks, roles, $STATE).
# Defaults to BUS_ROOT, so a plain `agent-launch NAME` is unchanged: the agent
# works in claude-bus, exactly as before. `--project-dir DIR` points it at a
# SECOND repo (e.g. ~/taro) while it stays a full claude-bus bus citizen.
project_dir=""
# SEC-1 isolation profile (docs/research-isolation.md):
#   worker   = bypass-permissions, caged in the claude-worker netns (egress
#              dropped except to the api.anthropic.com-only squid tier).
#   research = NON-bypass scholar, caged in claude-research (anthropic + a
#              curated read-only research allowlist). The ONLY web path.
# Default worker keeps the existing fleet's bypass behavior; the cage activates
# only once the NixOS module is applied (guarded on /run/netns below), so this
# flag is a safe no-op until then.
profile="worker"
while [ $# -gt 0 ]; do
    case "$1" in
        --role)
            [ $# -lt 2 ] && { echo "agent-launch: --role requires an argument" >&2; exit 2; }
            role=$2
            shift 2
            ;;
        --role=*)
            role=${1#--role=}
            shift
            ;;
        --project-dir)
            [ $# -lt 2 ] && { echo "agent-launch: --project-dir requires an argument" >&2; exit 2; }
            project_dir=$2
            shift 2
            ;;
        --project-dir=*)
            project_dir=${1#--project-dir=}
            shift
            ;;
        --profile)
            [ $# -lt 2 ] && { echo "agent-launch: --profile requires an argument" >&2; exit 2; }
            profile=$2
            shift 2
            ;;
        --profile=*)
            profile=${1#--profile=}
            shift
            ;;
        --)
            shift
            break
            ;;
        --*)
            echo "agent-launch: unknown flag: $1" >&2
            exit 2
            ;;
        *)
            break
            ;;
    esac
done

if [ "$#" -ne 1 ]; then
    echo "usage: agent-launch [--role ROLE] [--project-dir DIR] [--profile worker|research|orchestrator] NAME" >&2
    exit 2
fi

case "$profile" in
    worker|research|orchestrator) ;;
    *) echo "agent-launch: unknown --profile: $profile (want worker|research|orchestrator)" >&2; exit 2 ;;
esac

name=$1
cache_dir="$HOME/.cache/claude-bus/agents"
color_file="$cache_dir/$name.color"
mkdir -p "$cache_dir"

# The repo the agent WORKS in. Defaults to BUS_ROOT (claude-bus) — unchanged
# for the existing fleet. With --project-dir it's a second repo (e.g. ~/taro);
# the agent gets its workspace + cwd there but remains a claude-bus citizen
# (config/hooks/roles/binary/$STATE all still come from BUS_ROOT below).
PROJECT_ROOT=${project_dir:-$BUS_ROOT}

# Per-agent jj workspace, in PROJECT_ROOT. Each agent operates on its own
# working copy under $PROJECT_ROOT/.workspaces/$name, backed by that repo's
# shared .jj/repo. Removes the "scoop-bundle" pattern where one agent's
# `jj describe` swept up another's uncommitted edits. See
# docs/jj-workspace-workaround.md for why we use pure-jj workspaces.
#
# Set up the workspace BEFORE session detection so claude's cwd —
# which determines its project storage dir — is fixed before we look
# for prior sessions.
workspace_dir="$PROJECT_ROOT/.workspaces/$name"
if [ ! -d "$workspace_dir" ]; then
    mkdir -p "$PROJECT_ROOT/.workspaces"
    if ! (cd "$PROJECT_ROOT" && jj workspace add ".workspaces/$name" 2>&1); then
        echo "agent-launch: jj workspace add failed; launching in \$PROJECT_ROOT" >&2
    fi
fi
[ -d "$workspace_dir" ] || workspace_dir="$PROJECT_ROOT"
cd "$workspace_dir"

# --- Deterministic config propagation (1b), sourced from CLAUDE-BUS --------
# Materialize this workspace's Claude Code config from CLAUDE-BUS's LANDED
# main on every launch, into gitignored paths. This makes every agent a full
# bus citizen — same hooks/settings — regardless of which repo it WORKS in:
# a --project-dir taro peer has no settings/ of its own, so config MUST come
# from claude-bus (BUS_ROOT), not from PROJECT_ROOT's main. For a normal
# claude-bus agent BUS_ROOT == its repo, so behavior is unchanged.
#
# Source of truth = claude-bus's main, resolved with `jj -R "$BUS_ROOT"
# --ignore-working-copy` (staleness-immune: skips any working-copy snapshot,
# and -R targets claude-bus regardless of our cwd / which repo we're in).
# Then read each path BY COMMIT SHA through git --git-dir="$BUS_ROOT/.git":
#  - claude-settings.json: `git show <sha>:path` (cwd-independent; byte-
#    identical to the old `jj file show` — verified).
#  - settings/hooks-shared/*: `git archive <sha>` (one bulk export preserving
#    examples/; chmod +x since archive content is extracted mode-less).
# Reading by SHA is also ref-lag-immune: jj writes the commit OBJECT to git
# even when colocated refs/heads/main lags the jj bookmark (it does, when a
# push comes from a secondary workspace). Both targets are gitignored, so jj
# never sees these copies. Touches only this workspace.
main_rev=$(jj --ignore-working-copy -R "$BUS_ROOT" log --no-graph -r main -T 'commit_id' 2>/dev/null)
if [ -n "$main_rev" ]; then
    mkdir -p "$workspace_dir/.claude"
    # rm -f FIRST (mirrors the hooks/ rm -rf below) so we always write a FROZEN
    # per-workspace COPY. Without it, `>` follows a pre-existing LEGACY SYMLINK
    # (older workspaces still have .claude/settings.json -> the default-tree
    # canonical) and writes THROUGH it: settings.json stays a LIVE view while
    # settings/hooks/ is frozen-at-launch — so a live settings repoint (default
    # tree reconciles to main, gains a new hooks/<x> ref) desyncs from a running
    # agent's lagging hooks dir and blanks the bar (#15 runtime). The
    # write-through also clobbered the default-tree canonical every launch.
    # Freezing both symmetrically = config-via-relaunch, as CLAUDE.md intends.
    rm -f "$workspace_dir/.claude/settings.json"
    if ! git --git-dir="$BUS_ROOT/.git" show "$main_rev:settings/claude-settings.json" \
            > "$workspace_dir/.claude/settings.json" 2>/dev/null; then
        echo "agent-launch: WARN failed to materialize claude-settings.json from main" >&2
    fi
    rm -rf "$workspace_dir/settings/hooks"
    mkdir -p "$workspace_dir/settings/hooks"
    if git --git-dir="$BUS_ROOT/.git" archive "$main_rev" settings/hooks-shared 2>/dev/null \
            | tar -x --strip-components=2 -C "$workspace_dir/settings/hooks" 2>/dev/null; then
        chmod +x "$workspace_dir/settings/hooks"/*.sh 2>/dev/null
    else
        echo "agent-launch: WARN failed to materialize settings/hooks from main" >&2
    fi
    # Subagent definitions (.claude/agents/) — same #15-hardened frozen-copy as
    # hooks: rm -rf + fresh export from main, so the orchestrator's read-only
    # ro-worker type (docs/orchestrator-profile.md) is frozen-at-launch, never a
    # live view. strip-components=2 drops `settings/agents-shared/` → bare *.md
    # into .claude/agents/. Harmless for non-orchestrator agents (a defined type
    # only matters if invoked). Absent at main pre-land ⇒ graceful WARN.
    rm -rf "$workspace_dir/.claude/agents"
    mkdir -p "$workspace_dir/.claude/agents"
    if ! git --git-dir="$BUS_ROOT/.git" archive "$main_rev" settings/agents-shared 2>/dev/null \
            | tar -x --strip-components=2 -C "$workspace_dir/.claude/agents" 2>/dev/null; then
        echo "agent-launch: WARN failed to materialize .claude/agents from main" >&2
    fi
else
    echo "agent-launch: WARN could not resolve claude-bus main; config not refreshed" >&2
fi
# -------------------------------------------------------------------------

# --- Deterministic CODE propagation: auto-rebuild on drift (D4) ----------
# 1b (above) keeps CONFIG fresh per launch. CODE — this binary, this
# launcher, fleet.kdl — is a SINGLE shared artifact built from / run out of
# the default-tree checkout, which only advances when rebuilt. We detect
# drift by comparing the installed binary's build-commit stamp (`bus
# version`, full 40-hex) to landed main (main_rev, already resolved above —
# so the fast path adds only one `bus version` call + a string compare, no
# build). On drift, rebuild ONCE, flock-guarded, so N agents booting at once
# don't spawn N cmakes (first wins, the rest skip). The fresh binary lands on
# disk but the running broker + fleet ADOPT it only on restart/relaunch
# (printed below, never taken here — sulin's keyboard + the broker lifetime
# contract).
#
# SAFETY (unattended, so this matters more than for a manual step): the
# reconcile default-tree -> main step ABORTS if that tree is dirty — never
# `jj workspace update-stale` over uncommitted work (the data-loss trap). On
# dirty: warn loudly, skip the rebuild, boot against the stale binary. Never
# block boot, never clobber WIP.
#
# All of this is BUS_ROOT-scoped: it rebuilds claude-bus's bin/bus from
# claude-bus's main, regardless of PROJECT_ROOT. A --project-dir taro peer
# triggers exactly the same claude-bus rebuild (the shared binary it uses) —
# it never reconciles or cmake's PROJECT_ROOT.
if [ -n "$main_rev" ]; then
    built_commit=""
    [ -x "$BUS_ROOT/bin/bus" ] && built_commit=$("$BUS_ROOT/bin/bus" version \
        2>/dev/null | grep -oE '[0-9a-f]{40}' | head -1)
    if [ "$built_commit" != "$main_rev" ]; then
        disp=${built_commit:0:12}; [ -n "$disp" ] || disp="none"
        echo "agent-launch: code drift — bin/bus @ $disp, main @ ${main_rev:0:12}; rebuilding (flock-guarded)..." >&2
        rebuild_lock="$HOME/.cache/claude-bus/build.lock"
        (
            if flock -n 9; then
                # Re-check under the lock: a peer boot may have just rebuilt.
                cur=$("$BUS_ROOT/bin/bus" version 2>/dev/null \
                    | grep -oE '[0-9a-f]{40}' | head -1)
                [ "$cur" = "$main_rev" ] && exit 0
                # git-clean gate (reads the filesystem, so it works even when
                # jj reports the workspace stale). Never reconcile over WIP.
                if [ -n "$(git -C "$BUS_ROOT" status --porcelain 2>/dev/null)" ]; then
                    echo "agent-launch: WARN default tree dirty — skipping rebuild; booting STALE binary. Commit/land the WIP and relaunch to refresh." >&2
                    exit 0
                fi
                old_hash=none
                [ -x "$BUS_ROOT/bin/bus" ] && old_hash=$(sha256sum "$BUS_ROOT/bin/bus" | cut -d' ' -f1)
                # Reconcile only if the source itself lags (minimise touching
                # the default @). jj new main -> empty child of main; clean per
                # the gate, so no data loss.
                head=$(git -C "$BUS_ROOT" rev-parse HEAD 2>/dev/null)
                if [ "$head" != "$main_rev" ]; then
                    if ! ( cd "$BUS_ROOT" && jj new main ) >/dev/null 2>&1; then
                        echo "agent-launch: WARN reconcile to main failed — skipping rebuild (stale binary)" >&2
                        exit 0
                    fi
                fi
                # Re-configure (refreshes the build-commit stamp) then build.
                if ( cd "$BUS_ROOT" && nix develop --command bash -c \
                        'cmake -S . -B build >/dev/null && cmake --build build' ) \
                        >/dev/null 2>&1; then
                    new_commit=$("$BUS_ROOT/bin/bus" version 2>/dev/null \
                        | grep -oE '[0-9a-f]{40}' | head -1)
                    new_hash=$(sha256sum "$BUS_ROOT/bin/bus" | cut -d' ' -f1)
                    if [ "$old_hash" = "$new_hash" ]; then
                        echo "agent-launch: bin/bus reconfigured to ${new_commit:0:12} (no binary delta)" >&2
                    else
                        echo "agent-launch: *** bin/bus REBUILT ${old_hash:0:12} -> ${new_hash:0:12} (now @ ${new_commit:0:12}). RESTART the broker + RELAUNCH the fleet to ADOPT it (sulin's keyboard; broker lifetime contract — direct zellij child, never nohup/setsid). ***" >&2
                    fi
                else
                    echo "agent-launch: WARN rebuild FAILED — booting against the stale binary" >&2
                fi
            else
                echo "agent-launch: another boot holds the rebuild lock — proceeding; this pane picks up the fresh binary on its next 'bus' call." >&2
            fi
        ) 9>"$rebuild_lock"
    fi
fi
# -------------------------------------------------------------------------

# claude-code encodes the project's absolute path into the session
# storage dir by replacing '/', '.', and '_' all with '-'. The encoded
# path itself begins with '-' (from the leading '/' of cwd); the literal
# slash sits between "projects" and the encoded path. Probed
# empirically: `/tmp/foo_bar/.baz` becomes `-tmp-foo-bar--baz`.
encode_dir() { printf '%s' "$1" | sed 's|[/._]|-|g'; }
project_dir="$HOME/.claude/projects/$(encode_dir "$workspace_dir")"
legacy_project_dir="$HOME/.claude/projects/$(encode_dir "$BUS_ROOT")"
mkdir -p "$project_dir"

# Returns 0 if $1 contains any JSONL whose first line declares
# customTitle == name.
has_session() {
    local f
    for f in "$1"/*.jsonl; do
        [ -f "$f" ] || continue
        if head -c 256 "$f" | grep -q "\"customTitle\":\"$name\""; then
            return 0
        fi
    done
    return 1
}

# One-time migration: pull any legacy sessions whose customTitle matches
# NAME from the BUS_ROOT-rooted project dir (the old shared location,
# used before workspaces) into the workspace project dir. Idempotent —
# only fires when the workspace has no session for NAME yet, so once a
# fresh session is established here, prior history won't be moved on
# top of it.
if [ "$project_dir" != "$legacy_project_dir" ] \
        && [ -d "$legacy_project_dir" ] \
        && ! has_session "$project_dir"; then
    for f in "$legacy_project_dir"/*.jsonl; do
        [ -f "$f" ] || continue
        if head -c 256 "$f" | grep -q "\"customTitle\":\"$name\""; then
            mv "$f" "$project_dir/"
        fi
    done
fi

# Resume by --continue when a prior session exists; otherwise launch
# fresh. claude's --continue picks the most recent JSONL in cwd, which
# (per-workspace) is this agent's last session.
if has_session "$project_dir"; then
    claude_flag=(--continue)
    fresh_session=0
else
    claude_flag=()
    fresh_session=1
fi

# Assign a deterministic color from claude's 8-color palette if we don't
# have one yet. cksum gives a stable name -> index.
if [ ! -f "$color_file" ]; then
    colors=(red blue green yellow purple orange pink cyan)
    idx=$(( $(printf '%s' "$name" | cksum | cut -d' ' -f1) % ${#colors[@]} ))
    printf '%s\n' "${colors[$idx]}" > "$color_file"
fi
color=$(cat "$color_file")

# Fresh sessions: fork a subshell that waits for claude's TUI to be up
# and then sends /color via the bus. The fork survives the exec below;
# one-shot per spawn, no daemon needed.
if [ "$fresh_session" = 1 ]; then
    (
        for _ in $(seq 1 30); do
            sleep 1
            mode=$("$BUS_ROOT/bin/bus" pane-state "$name" 2>/dev/null \
                | awk '/^mode:/ {print $2}')
            if [ "$mode" = "INSERT" ]; then
                "$BUS_ROOT/bin/bus" send "$name" "/color $color" \
                    >/dev/null 2>&1 || true
                break
            fi
        done
    ) &
fi

claude_role_flag=()
if [ -n "$role" ]; then
    roles_cache="$HOME/.cache/claude-bus/roles"
    mkdir -p "$roles_cache"
    raw="$roles_cache/${role}.raw.md"
    stripped="$roles_cache/${role}.stripped.md"
    # Source the role from LANDED main (deterministic, staleness-immune) — the
    # same SHA-read pattern the 1b config materialization above uses (git
    # --git-dir show <sha>:path, ref-lag-immune). This closes gap #5: roles were
    # read from the default checkout's WORKING COPY, which lags main, so a role
    # authored + landed but not yet reconciled into the default tree silently
    # did NOT apply — unlike settings/hooks, which always equal main. Now a
    # landed role propagates fleet-wide by construction. Fall back to the
    # working copy with a LOUD warning when the role isn't on main yet (that's
    # the unlanded == non-deterministic case the gap was about).
    role_src=""
    if [ -n "$main_rev" ] \
            && git --git-dir="$BUS_ROOT/.git" show "$main_rev:roles/$role.md" \
                > "$raw" 2>/dev/null; then
        role_src="$raw"
    elif [ -f "$BUS_ROOT/roles/$role.md" ]; then
        echo "agent-launch: WARN role '$role' not on main — using the working copy (UNLANDED, non-deterministic). Land roles/$role.md to propagate it fleet-wide." >&2
        role_src="$BUS_ROOT/roles/$role.md"
    else
        echo "agent-launch: role not found on main or in working copy: $role" >&2
        exit 1
    fi
    awk 'BEGIN { in_fm = 0; done = 0 }
         NR == 1 && /^---$/ { in_fm = 1; next }
         in_fm && /^---$/ { in_fm = 0; done = 1; next }
         in_fm && !done { next }
         { print }' "$role_src" > "$stripped"
    claude_role_flag=(--append-system-prompt-file "$stripped")
fi

# Per-agent reasoning effort. comms is sulin's interface — LOW. auri is the
# fleet PM/hub — XHIGH (reserved for the PM). Every other agent is a coder —
# explicit HIGH. The coder default is set EXPLICITLY, not left to claude's
# built-in default: that default is XHIGH for a fresh session, so a no-flag
# peer (e.g. a fresh taro coder spawned via --project-dir) booted at xhigh
# until this `*)` rule pinned it. Levels: low|medium|high|xhigh|max.
claude_effort_flag=()
case "$name" in
    comms) claude_effort_flag=(--effort low) ;;
    auri)  claude_effort_flag=(--effort xhigh) ;;
    *)     claude_effort_flag=(--effort high) ;;
esac

export CLAUDE_BUS_AGENT_ID="$name"
export CLAUDE_BUS_AGENT_ROLE="$role"
export CLAUDE_BUS_AGENT_KIND="${CLAUDE_BUS_AGENT_KIND:-}"
export CLAUDE_BUS_AGENT_WORKSPACE="${CLAUDE_BUS_AGENT_WORKSPACE:-$workspace_dir}"
# Which repo the agent works in (BUS_ROOT for the claude-bus fleet, else the
# --project-dir target). Populates the existing register-hook field; not a
# new tracking surface.
export CLAUDE_BUS_AGENT_PROJECT="${CLAUDE_BUS_AGENT_PROJECT:-$PROJECT_ROOT}"
export CLAUDE_BUS_AGENT_SESSION="${CLAUDE_BUS_AGENT_SESSION:-}"

# After cd'ing into the workspace, `bin/bus` (relative) no longer
# resolves — the binary lives in the main $BUS_ROOT/bin and is
# gitignored, so agent workspaces don't carry it. Export CLAUDE_BUS_ROOT
# + put $BUS_ROOT/bin on PATH so `bus ...` works as a bare command and
# hooks can locate the binary absolutely.
export CLAUDE_BUS_ROOT="$BUS_ROOT"
case ":$PATH:" in
    *:"$BUS_ROOT/bin":*) ;;
    *) export PATH="$BUS_ROOT/bin:$PATH" ;;
esac

# Trust the project dir up front so claude doesn't HANG on the per-directory
# "Is this a project you trust?" modal at boot. claude keys trust on the
# project ROOT (the .git/.jj dir it finds walking up from cwd = PROJECT_ROOT),
# stored in ~/.claude.json projects[<root>].hasTrustDialogAccepted; there is no
# CLI/env bypass (only -p/print mode skips it), and --dangerously-skip-
# permissions does NOT cover it. So pre-register PROJECT_ROOT as trusted — a
# no-op for claude-bus (already trusted), and what lets a fresh second-repo
# peer (e.g. ~/taro) boot clean with no manual accept. Idempotent (skip if
# already true), flock'd against concurrent boots, atomic write; ~/.claude.json
# is the shared global config so we touch it only when actually needed.
cfg="$HOME/.claude.json"
if [ -f "$cfg" ] && command -v jq >/dev/null 2>&1; then
    (
        flock 9
        already=$(jq -r --arg d "$PROJECT_ROOT" \
            '.projects[$d].hasTrustDialogAccepted // false' "$cfg" 2>/dev/null)
        if [ "$already" != "true" ]; then
            tmp="$cfg.bus-trust.$$"
            if jq --arg d "$PROJECT_ROOT" \
                    '.projects[$d].hasTrustDialogAccepted = true' \
                    "$cfg" > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
                mv -f "$tmp" "$cfg"
            else
                rm -f "$tmp"
                echo "agent-launch: WARN could not pre-trust $PROJECT_ROOT in ~/.claude.json" >&2
            fi
        fi
    ) 9>"$HOME/.cache/claude-bus/claude-json.lock"
fi

# --- SEC-1 network cage (docs/research-isolation.md) ----------------------
# Map profile -> bypass-ness + cage netns + squid proxy IP. worker is bypass
# and caged to the api.anthropic.com-only squid tier; research is NON-bypass (a
# gated auto-mode scholar) caged to the research allowlist tier — the fleet's
# only sanctioned web path.
case "$profile" in
    worker)
        netns="claude-worker";   proxy="http://10.200.0.1:3128"
        bypass_flag=(--dangerously-skip-permissions); perm_flag=() ;;
    research)
        netns="claude-research";  proxy="http://10.200.0.5:3129"
        bypass_flag=()
        # Non-bypass read-only research envelope (auri's run-mode). The scholar
        # has internet, so its threat model is web-prompt-injection — it must be
        # UNABLE to act on fetched content. Auto-approve web + read tools and the
        # bus CLI (Bash(bus *) — its only mutation, used to report findings back
        # over the bus); HARD-DENY all repo mutation (Edit/Write/NotebookEdit) so
        # an injected page can plant nothing. Arbitrary/unlisted tools fall to
        # default (prompt) = fail-safe, never fail-open. NOT acceptEdits (an
        # injected page could plant an edit), NOT bypass.
        perm_flag=(--permission-mode default \
                   --allowedTools 'Bash(bus *),WebSearch,WebFetch,Read,Grep,Glob' \
                   --disallowedTools 'Edit,Write,NotebookEdit') ;;
    orchestrator)
        # Web-capable PM that FANS OUT read-only subagents (docs/orchestrator-
        # profile.md). NON-bypass is required BY THE MECHANISM, not policy: a
        # bypass/acceptEdits parent OVERRIDES its subagents' permission mode, so
        # they'd inherit bypass = ungated write-capable headless subagents = the
        # exact web-injection hole. --permission-mode default is what makes the
        # read-only-subagent restriction hold at all. No cage (web-capable; the
        # auto-gate is the defense, SEC-1 is optional defense-in-depth).
        netns="";  proxy=""
        bypass_flag=()
        # Pre-GRANT the safe read/web/coordinate set (auto-approve, no prompt).
        # Subagents inherit these grants -> a headless Explore/ro-worker's web
        # call auto-approves (never prompts, never auto-denies). Edit/Write/
        # NotebookEdit are in NEITHER list -> they fall to default = PROMPT the
        # in-pane human (the gate IS the safety for the dangerous post-web write).
        # Agent/Task/Workflow granted so fan-out itself doesn't prompt.
        perm_flag=(--permission-mode default \
                   --allowedTools 'Read,Grep,Glob,WebSearch,WebFetch,Bash(bus *),Agent,Task,Workflow')
        # ultracode = the Claude Code setting that sends xhigh AND turns ON
        # automatic workflow orchestration. It is session-only-rejected in
        # settings.json; the ONLY permanent mechanism is this env var, read at
        # claude startup. PROFILE-tied (not name-tied): the orchestrator profile
        # IS a workflow-orchestrator by definition, so workflow-on by construction
        # every relaunch. The orchestrator is never caged (netns=""), so it always
        # takes the plain `exec` below and inherits this export — no -E forwarding
        # needed. CLEAR the name-based --effort flag: an explicit --effort would
        # OVERRIDE the env (flag > env), pinning high and defeating ultracode's
        # xhigh; dropping it lets CLAUDE_CODE_EFFORT_LEVEL drive effort.
        export CLAUDE_CODE_EFFORT_LEVEL=ultracode
        claude_effort_flag=() ;;
esac
claude_cmd=(claude --name "$name" "${claude_flag[@]}" "${claude_role_flag[@]}" "${claude_effort_flag[@]}" "${bypass_flag[@]}" "${perm_flag[@]}")

if [ -n "$netns" ] && [ -e "/run/netns/$netns" ]; then
    # Cage present (NixOS module applied). Enter the netns via PID 1, then DROP
    # to this uid before exec — so a bypass worker holds CAP_SYS_ADMIN at NO
    # instant (the one place netns would leak; design §6). NoNewPrivileges=yes +
    # an explicitly EMPTY AmbientCapabilities pin that: the worker provably
    # cannot acquire any capability (incl. CAP_SYS_ADMIN) via execve, so it can
    # never setns out of the cage. The proxy is squid's IP (not a hostname), so
    # the cage needs ZERO DNS — one fewer endpoint reachable inside it. --scope
    # keeps the zellij pane's TTY; polkit (the module) makes this passwordless
    # for the cage-* unit only. --system starts a near-empty env, so forward
    # exactly what claude + the hooks need. NOTE: exercised only once the module
    # is live — validate on the first real caged launch.
    exec systemd-run --system --scope --quiet --collect \
        --unit="cage-${name}-$$" \
        -p "NetworkNamespacePath=/run/netns/$netns" \
        -p "User=$(id -un)" \
        -p "WorkingDirectory=$workspace_dir" \
        -p "NoNewPrivileges=yes" \
        -p "AmbientCapabilities=" \
        -E "HTTPS_PROXY=$proxy" -E "HTTP_PROXY=$proxy" \
        -E "TERM=${TERM:-xterm-256color}" -E HOME -E PATH -E USER \
        -E CLAUDE_BUS_ROOT -E CLAUDE_BUS_AGENT_ID -E CLAUDE_BUS_AGENT_ROLE \
        -E CLAUDE_BUS_AGENT_KIND -E CLAUDE_BUS_AGENT_WORKSPACE \
        -E CLAUDE_BUS_AGENT_PROJECT -E CLAUDE_BUS_AGENT_SESSION \
        -- "${claude_cmd[@]}"
fi

# No cage (module not applied) — behavior is byte-identical to pre-SEC-1: a
# plain worker launch with --dangerously-skip-permissions, a research launch
# without it. The barrier is dormant until sulin applies nixos/research-
# isolation.nix and the /run/netns cages exist; only then does the branch above
# take over. (No per-boot warning on purpose — pre-rollout this is the expected
# state, not an error.)
exec "${claude_cmd[@]}"
