#!/usr/bin/env bash
# intake — non-blocking task producer for sulin.
#
# Queue a task to a peer's inbox WITHOUT waiting on comms mid-turn. Pure
# producer over `bus msg mail`: no model, no judgment, acks instantly.
# The broker delivers each inbox to its agent when that agent next idles,
# so a queued task simply waits in the inbox — sulin never blocks on a
# busy comms pane.
#
# Usage:
#   intake "task text ..."          queue to comms (the default target)
#   intake --to NAME "task ..."     queue straight to NAME's inbox
#   intake                          interactive input surface (the fleet
#                                   "intake" pane): prompt / read / send /
#                                   loop. Prefix a line with "@NAME " to
#                                   fire at a peer; bare lines go to the
#                                   default target. "q" or Ctrl-D quits.
set -uo pipefail

BUS="${CLAUDE_BUS_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}/bin/bus"
to="comms"
[ "${1:-}" = "--to" ] && { to="${2:?intake: --to needs a NAME}"; shift 2; }

send() {  # send TARGET BODY...
    local tgt="$1"; shift
    local body="$*"
    [ -n "$body" ] || return 0
    if "$BUS" msg mail "$tgt" "[sulin] $body" >/dev/null 2>&1; then
        printf '\033[32m✓ queued → %s\033[0m\n' "$tgt"
    else
        printf '\033[31m✗ failed → %s (broker up?)\033[0m\n' "$tgt"
    fi
}

# One-shot: task text on the command line.
if [ "$#" -gt 0 ]; then
    send "$to" "$@"
    exit 0
fi

# Interactive: the always-available input surface. Type while comms is
# mid-turn; the task lands in the inbox and delivers when comms idles.
printf '\033[1mintake\033[0m → default %s. Type a task + Enter to queue. "@name task" targets a peer. "q" quits.\n' "$to"
while IFS= read -r -p 'task> ' line; do
    case "$line" in
        q|quit|exit) break ;;
        "") continue ;;
        @*) peer="${line%% *}"; rest="${line#"$peer"}"; peer="${peer#@}"
            send "$peer" "${rest# }" ;;
        *)  send "$to" "$line" ;;
    esac
done
