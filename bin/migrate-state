#!/usr/bin/env bash
# migrate-state — one-time copy of bus state from the old volatile root
# (/tmp/claude-bus) to the durable root, for the $STATE-off-/tmp move
# (1a). Run ONCE before the first boot of the durable-root broker.
#
# Safe to re-run: cp -n never clobbers newer state in the destination,
# and volatile runtime files (socket/pid/in-flight/presence) are skipped
# — a stale one would only confuse the fresh broker. Durable artifacts
# carry over: topic logs, cursors, broker.epoch, events.jsonl, the topic
# registry, agent registry, titles, off-TTY sentinels, learnings.
#
# NOTE: the boot-epoch fence quarantines any migrated mail (it carries
# the old broker run's epoch), so history moves over for audit/replay
# without being re-delivered as new. That's the intended, safe outcome.

set -euo pipefail

OLD=/tmp/claude-bus
NEW="${CLAUDE_BUS_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/claude-bus}"

if [ "$OLD" = "$NEW" ]; then
    echo "migrate-state: old == new ($NEW); nothing to do"
    exit 0
fi
if [ ! -d "$OLD" ]; then
    echo "migrate-state: no old state at $OLD; nothing to migrate"
    exit 0
fi

mkdir -p "$NEW"
shopt -s nullglob dotglob
for entry in "$OLD"/*; do
    base="$(basename "$entry")"
    case "$base" in
        broker.sock | broker.pid | in-flight | presence) continue ;;
    esac
    cp -rn "$entry" "$NEW"/ 2>/dev/null || true
done
shopt -u nullglob dotglob

echo "migrate-state: $OLD -> $NEW (durable artifacts copied; volatile skipped)"
