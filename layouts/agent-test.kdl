// Minimal test rig: one agent (alice) + ops. Each agent tab gets the
// per-agent status strip via `bus agent-bar` — same shape as fleet.kdl.
//
// Path resolution: same idiom as fleet.kdl — bash wrappers resolve
// the repo root as ${CLAUDE_BUS_ROOT:-$PWD}, so launching from the
// project root just works without editing this file.

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    tab_template name="agent_tab" {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    agent_tab name="alice" focus=true {
        pane size=1 borderless=true name="alice-bar" command="bash" {
            args "-c" "exec \"${CLAUDE_BUS_ROOT:-$PWD}/bin/bus\" agent-bar alice"
        }
        pane name="alice" command="bash" {
            args "-c" "CLAUDE_BUS_AGENT_ID=alice exec claude --dangerously-skip-permissions"
        }
    }

    tab name="ops" {
        // Observability + the human inbox. The broker runs in the
        // floating pane below — close it to stop delivery. Inbox
        // dominates the tab (it's the human's destination on the bus);
        // monitor sits on the side.
        floating_panes {
            pane name="broker" {
                x "55%"
                y "10%"
                width "40%"
                height "30%"
                command "bash"
                args "-c" "exec \"${CLAUDE_BUS_ROOT:-$PWD}/bin/bus\" broker run"
            }
        }
        pane split_direction="horizontal" {
            pane name="human-inbox" size="67%" command="bash" {
                args "-c" "exec \"${CLAUDE_BUS_ROOT:-$PWD}/bin/bus\" inbox human"
            }
            pane name="monitor" command="bash" {
                args "-c" "exec \"${CLAUDE_BUS_ROOT:-$PWD}/bin/bus\" monitor"
            }
        }
    }

    tab name="test" {
        pane command="bash" {
            args "-c" "cd \"${CLAUDE_BUS_ROOT:-$PWD}\" && exec bash -l"
        }
    }
}
