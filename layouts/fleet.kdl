// Full working layout: a single comms tab + the named agent fleet.
//
// COMMS TAB (focus on launch):
//   ┌─ comms-bar (1 row) ────────────────────────────────────────────┐
//   │                                  │                              │
//   │     comms pane (claude)          │       ops-inbox              │
//   │        55% width                 │         45% width            │
//   │                                  │                              │
//   ├──────────────────────────────────┴──────────────────────────────┤
//   │          monitor (full-width bottom strip, ~15 rows)            │
//   └────────────────────────────────────────────────────────────────┘
//   Plus the broker as a floating pane (toggle with ctrl+p w).
//
// One tab gives sulin everything human-facing without switching: the
// comms agent for orchestration, the ops-inbox tail for infrastructure
// notifications (delivery failures, audit escalation), and the monitor
// for fleet state at a glance. The broker float is in this tab too so
// closing it terminates delivery — relaunch the layout to bring it
// back. A flock on $STATE/broker.pid keeps the singleton.
//
// AGENT TABS (bast / kvothe / elodin):
//   comms-bar-style 1-row strip + agent-launch'd claude pane. Sulin
//   switches tabs only when attaching to an individual agent.
//
// `comms` is the human's communications layer (see docs/comms.md +
// roles/comms.md). It launches via agent-launch's --role flag, which
// appends roles/comms.md to claude's system prompt and exports
// CLAUDE_BUS_AGENT_ROLE so the register hook records it in
// $CLAUDE_BUS_STATE/agents/comms.json.
//
// agent_tab is a named alias of default_tab_template. zellij templates
// can't parameterize per-instance command args, so each usage inlines
// its own agent-bar pane with the agent's name. Keep the bar's name
// field in sync with the agent's name so monitor / pane-id keep
// working.
//
// All non-agent panes call the unified `bus` binary with the matching
// subcommand. bin/agent-launch stays as shell for now; it does session
// UUID discovery + color seeding + role injection before exec'ing
// claude.
//
// Path resolution: zellij KDL doesn't expand env vars in attribute
// strings, so this file uses bash wrappers everywhere and resolves the
// repo root inside bash as ${CLAUDE_BUS_ROOT:-$PWD}. The expectation
// is that the user launches zellij from the project root (or with
// CLAUDE_BUS_ROOT exported), which makes the bus relocatable without
// editing this file.
//
// Launch:   zellij --layout layouts/fleet.kdl

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    tab_template name="agent_tab" {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    agent_tab name="comms" focus=true {
        // Broker runs in a float so its log is visible on demand —
        // toggle with ctrl+p w. The broker's lifetime is tied to this
        // pane: closing it terminates the broker, and the bus stops
        // delivering (records still queue to disk). Relaunch the
        // layout to bring it back. A flock on $STATE/broker.pid keeps
        // the singleton — a second `bus broker run` exits 1.
        floating_panes {
            pane name="broker" {
                command "bash"
                args "-c" "exec \"${CLAUDE_BUS_ROOT:-$PWD}/bin/bus\" broker run"
            }
        }
        // comms-bar at the top: same 1-row strip every agent tab has.
        pane size=1 borderless=true name="comms-bar" command="bash" {
            args "-c" "B=${CLAUDE_BUS_ROOT:-$PWD}; trap 'exit 0' INT; while :; do \"$B/bin/bus\" agent-bar comms; printf '\\033[1;31m[comms-bar exited rc=%d -- restarting in 2s]\\033[0m' \"$?\"; sleep 2; done"
        }
        // Top: comms pane + ops-inbox side by side. Bottom: monitor as
        // a full-width strip. Viewers other than the agent are wrapped
        // in a bash restart loop so an unexpected exit (SIGHUP, SIGPIPE,
        // etc.) produces a visible banner and auto-respawns instead of
        // leaving a frozen alt-screen frame. `trap 'exit 0' INT` lets a
        // manual Ctrl+C end the wrapper.
        pane split_direction="horizontal" {
            pane split_direction="vertical" {
                // Wrap agent-launch in bash so CLAUDE_BUS_AGENT_KIND
                // and CLAUDE_BUS_AGENT_SESSION reach the agent-register
                // hook.
                pane name="comms" size="55%" command="bash" {
                    args "-c" "B=${CLAUDE_BUS_ROOT:-$PWD}; cd \"$B\"; export CLAUDE_BUS_AGENT_KIND=coordinator CLAUDE_BUS_AGENT_SESSION=fleet; exec \"$B/bin/agent-launch\" --role comms comms"
                }
                pane name="ops-inbox" command="bash" {
                    args "-c" "B=${CLAUDE_BUS_ROOT:-$PWD}; trap 'exit 0' INT; while :; do \"$B/bin/bus\" topic inbox ops; rc=$?; printf '\\n\\033[1;31m[inbox-ops exited rc=%d at %s — restarting in 2s]\\033[0m\\n' \"$rc\" \"$(date +%H:%M:%S)\"; sleep 2; done"
                }
            }
            // Fixed 15-row monitor strip — the bus monitor dashboard
            // renders header + table for the active fleet in ~10-15
            // lines; the fixed size avoids it dominating the screen on
            // tall terminals and getting cropped on short ones.
            pane name="monitor" size=15 command="bash" {
                args "-c" "B=${CLAUDE_BUS_ROOT:-$PWD}; trap 'exit 0' INT; while :; do \"$B/bin/bus\" monitor; rc=$?; printf '\\n\\033[1;31m[monitor exited rc=%d at %s — restarting in 2s]\\033[0m\\n' \"$rc\" \"$(date +%H:%M:%S)\"; sleep 2; done"
            }
        }
    }

    agent_tab name="bast" {
        pane size=1 borderless=true name="bast-bar" command="bash" {
            args "-c" "B=${CLAUDE_BUS_ROOT:-$PWD}; trap 'exit 0' INT; while :; do \"$B/bin/bus\" agent-bar bast; printf '\\033[1;31m[bast-bar exited rc=%d -- restarting in 2s]\\033[0m' \"$?\"; sleep 2; done"
        }
        pane name="bast" command="bash" {
            args "-c" "B=${CLAUDE_BUS_ROOT:-$PWD}; cd \"$B\"; exec \"$B/bin/agent-launch\" bast"
        }
    }

    agent_tab name="kvothe" {
        pane size=1 borderless=true name="kvothe-bar" command="bash" {
            args "-c" "B=${CLAUDE_BUS_ROOT:-$PWD}; trap 'exit 0' INT; while :; do \"$B/bin/bus\" agent-bar kvothe; printf '\\033[1;31m[kvothe-bar exited rc=%d -- restarting in 2s]\\033[0m' \"$?\"; sleep 2; done"
        }
        pane name="kvothe" command="bash" {
            args "-c" "B=${CLAUDE_BUS_ROOT:-$PWD}; cd \"$B\"; exec \"$B/bin/agent-launch\" kvothe"
        }
    }

    agent_tab name="elodin" {
        pane size=1 borderless=true name="elodin-bar" command="bash" {
            args "-c" "B=${CLAUDE_BUS_ROOT:-$PWD}; trap 'exit 0' INT; while :; do \"$B/bin/bus\" agent-bar elodin; printf '\\033[1;31m[elodin-bar exited rc=%d -- restarting in 2s]\\033[0m' \"$?\"; sleep 2; done"
        }
        pane name="elodin" command="bash" {
            args "-c" "B=${CLAUDE_BUS_ROOT:-$PWD}; cd \"$B\"; exec \"$B/bin/agent-launch\" elodin"
        }
    }
}
