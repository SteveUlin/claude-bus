{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/settings/hooks/log-event.sh UserPromptSubmit"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/settings/hooks/inbox-drain.sh UserPromptSubmit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/settings/hooks/log-event.sh PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/settings/hooks/log-event.sh PostToolUse"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/settings/hooks/focus-write.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/settings/hooks/config-drift-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/settings/hooks/log-event.sh Stop"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/settings/hooks/log-event.sh SessionStart"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/settings/hooks/agent-register.sh SessionStart"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/settings/hooks/inject-learnings.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/settings/hooks/inbox-drain.sh SessionStart"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/settings/hooks/log-event.sh SessionEnd"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/settings/hooks/agent-register.sh SessionEnd"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/settings/hooks/log-event.sh Notification"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/settings/hooks/log-event.sh PreCompact"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
    "OTEL_METRIC_EXPORT_INTERVAL": "10000",
    "OTEL_LOGS_EXPORT_INTERVAL": "5000",
    "OTEL_RESOURCE_ATTRIBUTES": "service.name=claude-bus"
  },
  "statusLine": {
    "type": "command",
    "command": "$CLAUDE_PROJECT_DIR/settings/hooks/statusline.sh"
  },
  "theme": "dark"
}
