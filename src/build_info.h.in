// Generated by CMake (configure_file) — do not edit by hand.
//
// Carries the commit the binary was built from, for D4 code-drift
// detection: agent-launch compares BUS_BUILD_COMMIT against landed main and
// auto-rebuilds bin/bus when they diverge. Colocated git HEAD == the jj
// commit_id, so this is the same 40-hex id agent-launch reads via
// `jj log -r main`. Refreshed on every CMake configure; the auto-rebuild
// re-configures so a deployed binary's stamp tracks the source it built
// from. "unknown" when git is unavailable at configure time.
#pragma once
#define BUS_BUILD_COMMIT "@BUS_BUILD_COMMIT@"
